/// 8×8 mono sprites: opaque blit row + transparent bouncing arrow.
import "../../waveshare_rp2350_lcd_096" board

@[link("startup.s")]
@[link("image_def.S")]
fn main() {
    let lcd = board.lcd_out(12000000, 1000000)
    lcd.backlight(true)
    lcd.fill(board.color_black())

    let mut title: [8]i32
    title[0] = 'S'
    title[1] = 'P'
    title[2] = 'R'
    title[3] = 'I'
    title[4] = 'T'
    title[5] = 'E'
    title[6] = 'S'
    lcd.draw_text_n(8, 8, title[:], 7, board.color_white(), board.color_black())

    let mut heart: [8]i32
    let mut check: [8]i32
    let mut batt: [8]i32
    let mut smile: [8]i32
    let mut arrow: [8]i32
    board.sprite_heart(heart[:])
    board.sprite_check(check[:])
    board.sprite_battery(batt[:])
    board.sprite_smile(smile[:])
    board.sprite_arrow_r(arrow[:])

    lcd.blit_mono8(16, 28, heart[:], board.color_red(), board.color_black())
    lcd.blit_mono8(40, 28, check[:], board.color_green(), board.color_black())
    lcd.blit_mono8(64, 28, batt[:], board.color_yellow(), board.color_black())
    lcd.blit_mono8(88, 28, smile[:], board.color_cyan(), board.color_black())

    let mut x: i32 = 8
    let mut dir: i32 = 1
    while true {
        // clear previous arrow footprint
        lcd.fill_rect(x, 52, 8, 8, board.color_black())
        x = x + dir
        if x > 140 {
            dir = 0 - 1
            x = 140
        }
        if x < 8 {
            dir = 1
            x = 8
        }
        lcd.blit_mono8_trans(x, 52, arrow[:], board.color_magenta())
        board.delay_ms(40)
    }
}

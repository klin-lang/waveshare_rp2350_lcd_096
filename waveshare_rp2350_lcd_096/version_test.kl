module waveshare_rp2350_lcd_096

import testing

// Host-safe checks only (no MMIO). Skipped on package import (*_test.kl).

fn test_version() {
    testing.assert_eq_i32(version(), 11)
}

fn test_pin_map() {
    testing.assert_eq_i32(lcd_dc(), 8)
    testing.assert_eq_i32(lcd_cs(), 9)
    testing.assert_eq_i32(lcd_sclk(), 10)
    testing.assert_eq_i32(lcd_mosi(), 11)
    testing.assert_eq_i32(lcd_rst(), 12)
    testing.assert_eq_i32(lcd_bl(), 25)
    testing.assert_eq_i32(lcd_width(), 160)
    testing.assert_eq_i32(lcd_height(), 80)
    testing.assert_eq_i32(lcd_x_offset(), 1)
    testing.assert_eq_i32(lcd_y_offset(), 26)
    testing.assert_eq_i32(voltage_monitor(), 29)
    testing.assert_eq_i32(voltage_monitor_adc_ch(), 3)
    testing.assert_eq_i32(temp_adc_ch(), 4)
    testing.assert_eq_i32(uart0_unit(), 0)
    testing.assert_eq_i32(uart0_tx(), 0)
    testing.assert_eq_i32(uart0_rx(), 1)
    testing.assert_eq_i32(uart_default_baud(), 115200)
}

fn test_font_metrics() {
    testing.assert_eq_i32(font_char_w(), 6)
    testing.assert_eq_i32(font_char_h(), 8)
    // '0' col0 should be non-zero; space columns are zero.
    testing.assert_eq_i32(font5x7_col(32, 0), 0)
    testing.assert(font5x7_col('0', 0) != 0)
}

fn test_sense_math() {
    // Mid-scale ~1650 mV at pin.
    testing.assert_eq_i32(adc12_to_mv(2048), 1650)
    // Divider 3:1 → pack mV.
    testing.assert_eq_i32(battery_mv_from_adc12(2048), 4950)
    // Full / empty percent clamps.
    testing.assert_eq_i32(battery_pct(3000), 0)
    testing.assert_eq_i32(battery_pct(4200), 100)
    // Temp near 27°C when ADC ≈ 0.706 V → raw ≈ 0.706/3.3*4096 ≈ 876
    let t = temp_c_from_adc12(876)
    testing.assert(t >= 25)
    testing.assert(t <= 29)
}

fn test_format_u32() {
    let mut buf: [8]i32
    let n = format_u32(buf[:], 123)
    testing.assert_eq_i32(n, 3)
    testing.assert_eq_i32(buf[0], '1')
    testing.assert_eq_i32(buf[1], '2')
    testing.assert_eq_i32(buf[2], '3')
}

fn test_sprites8() {
    testing.assert_eq_i32(sprite_size(), 8)
    let mut rows: [8]i32
    sprite_heart(rows[:])
    testing.assert_eq_i32(rows[0], 0x66)
    testing.assert(rows[1] != 0)
    sprite_check(rows[:])
    testing.assert(rows[3] != 0)
    sprite_arrow_r(rows[:])
    testing.assert_eq_i32(rows[3], 0xFF)
}

fn test_sleep_reload() {
    testing.assert_eq_i32(sleep_cpu_hz(), 12000000)
    testing.assert_eq_i32(sleep_systick_reload(0), 0)
    // 1 ms @ 12 MHz → 12000 ticks → reload 11999
    testing.assert_eq_i32(sleep_systick_reload(1), 11999)
    testing.assert(sleep_systick_reload(1000) > 0)
    testing.assert(sleep_systick_reload(1000) <= 0xFFFFFF)
}


fn test_ws2812() {
    testing.assert_eq_i32(ws2812_data(), 15)
    testing.assert_eq_i32(ws2812_cpu_hz(), 12000000)
    testing.assert_eq_i32(ws2812_pio_bit_hz(), 8000000)
    testing.assert_eq_i32(ws2812_rgb(1, 2, 3), 0x00010203)
    testing.assert(ws2812_t1h() > ws2812_t0h())
}

fn test_powman_consts() {
    testing.assert_eq_i32(powman_password(), 0x5afe0000)
    testing.assert_eq_i32(powman_base(), 0x40100000)
}

fn test_lcd_dma_ch() {
    testing.assert_eq_i32(lcd_dma_ch(), 0)
    testing.assert_eq_i32(lcd_spi(), 1)
}

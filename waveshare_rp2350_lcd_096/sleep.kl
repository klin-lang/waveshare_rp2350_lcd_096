/// Light-sleep helpers (SysTick reload math). The WFI loop lives in the app
/// (`examples/sleep_demo`) so host `klin test` stays free of ARM `asm`.
/// For POWMAN switched-core power-down see `powman.kl` / `examples/powman_demo`.
module waveshare_rp2350_lcd_096

/// Assumed `clk_sys` for SysTick reload math (board demos use ~12 MHz peri).
/// Explicit constant — not read from the clock tree. Tune if you set PLL/ROSC.
pub fn sleep_cpu_hz(): i32 {
    return 12000000
}

/// SysTick reload value for approximately `ms` milliseconds (clamped to 1..=1000 ms
/// and 24-bit SysTick). Returns 0 if `ms < 1`.
pub fn sleep_systick_reload(ms: i32): i32 {
    let mut m = ms
    if m < 1 {
        return 0
    }
    if m > 1000 {
        m = 1000
    }
    let hz = sleep_cpu_hz()
    let ticks = (hz / 1000) * m
    let mut reload = ticks - 1
    if reload < 1 {
        reload = 1
    }
    if reload > 0xFFFFFF {
        reload = 0xFFFFFF
    }
    return reload
}

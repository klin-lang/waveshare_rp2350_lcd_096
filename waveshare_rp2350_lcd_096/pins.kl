/// Waveshare RP2350-LCD-0.96 pin map (CircuitPython / Arduino / wiki).
/// No onboard NeoPixel in the CircuitPython board def — blink = LCD backlight.
module waveshare_rp2350_lcd_096

/// ST7735S SPI unit (SPI1).
pub fn lcd_spi(): i32 {
    return 1
}

pub fn lcd_dc(): i32 {
    return 8
}

pub fn lcd_cs(): i32 {
    return 9
}

pub fn lcd_sclk(): i32 {
    return 10
}

pub fn lcd_mosi(): i32 {
    return 11
}

pub fn lcd_rst(): i32 {
    return 12
}

/// Backlight (PWM-capable).
pub fn lcd_bl(): i32 {
    return 25
}

/// Dummy MISO for `machine.spi_out_rp2350` (LCD is write-only).
pub fn lcd_miso_unused(): i32 {
    return 13
}

pub fn lcd_width(): i32 {
    return 160
}

pub fn lcd_height(): i32 {
    return 80
}

/// ST7735S window offsets (Waveshare 160×80).
pub fn lcd_x_offset(): i32 {
    return 1
}

pub fn lcd_y_offset(): i32 {
    return 26
}

/// VBUS sense (input).
pub fn vbus_sense(): i32 {
    return 24
}

/// Battery / voltage monitor ADC GPIO (GP29 = ADC3).
pub fn voltage_monitor(): i32 {
    return 29
}

/// ADC channel for `voltage_monitor` (GP29 → ch3).
pub fn voltage_monitor_adc_ch(): i32 {
    return 3
}

/// On-die temperature sensor ADC channel.
pub fn temp_adc_ch(): i32 {
    return 4
}

/// VSYS/battery resistive divider (pin_mv * num / den → pack mV). Waveshare ≈ 1:3.
pub fn battery_divider_num(): i32 {
    return 3
}

pub fn battery_divider_den(): i32 {
    return 1
}

/// Soft empty/full thresholds for the percent bar (Li-ion single cell).
pub fn battery_empty_mv(): i32 {
    return 3300
}

pub fn battery_full_mv(): i32 {
    return 4200
}

/// Default console UART (Pico-compatible header / Arduino SERIAL1).
/// Needs an external USB–UART adapter — Type-C is native USB, not this UART.
pub fn uart0_unit(): i32 {
    return 0
}

pub fn uart0_tx(): i32 {
    return 0
}

pub fn uart0_rx(): i32 {
    return 1
}

pub fn uart_default_baud(): i32 {
    return 115200
}

/// Default DIN for an **external** WS2812 strip (header GP15). No onboard NeoPixel.
pub fn ws2812_data(): i32 {
    return 15
}

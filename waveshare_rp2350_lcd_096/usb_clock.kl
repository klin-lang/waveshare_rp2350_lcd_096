/// Explicit RP2350 XOSC → PLL_USB → clk_usb @ 48 MHz (MMIO).
/// Required before `machine.usb_cdc_out_rp2350`. Not started by `machine_rp`.
module waveshare_rp2350_lcd_096

/// Start onboard 12 MHz XOSC (crystal). Safe to call once.
pub fn enable_xosc() {
    // XOSC @ 0x40048000 — CTRL 0x00, STATUS 0x04, STARTUP 0x0C
    let ctrl = cast(*mut volatile i32, 0x40048000)
    let status = cast(*mut volatile i32, 0x40048004)
    let startup = cast(*mut volatile i32, 0x4004800C)

    // FREQ_RANGE = 1_15MHZ (0xaa0)
    *ctrl = 0xaa0
    // STARTUP delay (pico default-ish)
    *startup = 47
    // ENABLE = 0xfab << 12 | FREQ_RANGE
    *ctrl = (0xfab << 12) | 0xaa0
    while (*status & (1 << 31)) == 0 {
    }
}

/// PLL_USB: 12 MHz × 40 / 5 / 2 = 48 MHz (VCO 480 MHz; pico-sdk defaults).
pub fn enable_pll_usb_48m() {
    // RESETS: PLL_USB bit 15 — atomic clear @ 0x40023000
    let reset_clr = cast(*mut volatile i32, 0x40023000)
    *reset_clr = 1 << 15
    let done = cast(*mut volatile i32, 0x40020008)
    while (*done & (1 << 15)) == 0 {
    }

    // PLL_USB @ 0x40058000
    let cs = cast(*mut volatile i32, 0x40058000)
    let pwr = cast(*mut volatile i32, 0x40058004)
    let fbdiv = cast(*mut volatile i32, 0x40058008)
    let prim = cast(*mut volatile i32, 0x4005800C)

    // REFDIV = 1
    *cs = 1
    *fbdiv = 40
    // Power up VCO; keep POSTDIVPD until lock (PWR bit 3)
    *pwr = 1 << 3
    while (*cs & (1 << 31)) == 0 {
    }
    // POSTDIV1=5, POSTDIV2=2 → 480/10 = 48 MHz
    *prim = (5 << 16) | (2 << 12)
    *pwr = 0
}

/// Route clk_usb from PLL_USB, divider 1.0, enable.
pub fn enable_clk_usb() {
    // CLOCKS @ 0x40010000 — CLK_USB_CTRL 0x60, CLK_USB_DIV 0x64
    let ctrl = cast(*mut volatile i32, 0x40010060)
    let div = cast(*mut volatile i32, 0x40010064)
    let wake = cast(*mut volatile i32, 0x400100AC)

    // WAKE_EN0 bit for clk_usb — bit 3 on RP2350 (CLK_USB)
    *wake = *wake | (1 << 3)

    *ctrl = 0
    *div = 1 << 16
    // AUXSRC = clksrc_pll_usb (0), ENABLE
    *ctrl = 1 << 11

    let mut i: i32 = 0
    while i < 100 {
        i = i + 1
    }
}

/// XOSC + PLL_USB + clk_usb @ 48 MHz. Call before USB CDC.
pub fn enable_usb_clocks() {
    enable_xosc()
    enable_pll_usb_48m()
    enable_clk_usb()
}
